# ───────────────────────── Datastream configuration ─────────────────────────
# Copy to `.env` and fill in. Never commit `.env`.
# Only public addresses / xpubs / viewing keys are ever stored. No private keys.

# ── Core ─────────────────────────────────────────────────────────────────────
# REQUIRED. 32 random bytes, base64. Generate with: pnpm ds gen-key
# Encrypts xpubs, viewing keys and alert secrets at rest. Back it up separately
# from the database; without it the encrypted data can't be recovered.
DATASTREAM_ENC_KEY=
# Only during key rotation: the old key (see README → Key rotation).
DATASTREAM_ENC_KEY_PREVIOUS=

DATABASE_PATH=./data/datastream.db
BACKUP_DIR=./data/backups
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
LOG_LEVEL=info

# ── Access ───────────────────────────────────────────────────────────────────
# password | network-only (network-only requires ALLOWED_CIDRS)
AUTH_MODE=password
# One-time token for first-run setup at /setup. Remove after setting a password.
SETUP_TOKEN=
# Failed logins allowed per IP per 15 minutes.
LOGIN_MAX_ATTEMPTS=5
SESSION_TTL_HOURS=720
SESSION_IDLE_HOURS=168
# Keep true behind HTTPS (Caddy / Tailscale). false only for plain-HTTP LAN.
COOKIE_SECURE=true
# Comma-separated allowlist, e.g. 192.168.0.0/16,100.64.0.0/10 (Tailscale).
# Requires TRUST_PROXY=true behind a reverse proxy that sets X-Forwarded-For.
ALLOWED_CIDRS=
TRUST_PROXY=false
# Used for links in alert messages, e.g. https://datastream.tailnet.ts.net
PUBLIC_URL=

# ── Sync ─────────────────────────────────────────────────────────────────────
SYNC_INTERVAL_MINUTES=15
PRICE_INTERVAL_MINUTES=5
HTTP_TIMEOUT_MS=20000

# ── Bitcoin ──────────────────────────────────────────────────────────────────
# Any Esplora-compatible API. Point at your own mempool/electrs for privacy.
BTC_ESPLORA_URL=https://mempool.space/api
BTC_EXPLORER_URL=https://mempool.space
BTC_GAP_LIMIT=20
# Requests/second. mempool.space blocks aggressive clients; use 10+ for your own instance.
BTC_ESPLORA_RPS=1

# ── Ethereum ─────────────────────────────────────────────────────────────────
# etherscan | alchemy
ETH_PROVIDER=etherscan
ETHERSCAN_API_URL=https://api.etherscan.io/v2/api
ETHERSCAN_API_KEY=
ALCHEMY_API_URL=
ALCHEMY_API_KEY=
ETH_EXPLORER_URL=https://etherscan.io

# ── Solana ───────────────────────────────────────────────────────────────────
# helius | rpc
SOL_PROVIDER=rpc
SOL_RPC_URL=https://api.mainnet-beta.solana.com
# Requests/second to SOL_RPC_URL (public RPC is heavily rate-limited).
SOL_RPC_RPS=2
HELIUS_API_KEY=
HELIUS_RPC_URL=https://mainnet.helius-rpc.com
SOL_EXPLORER_URL=https://solscan.io

# ── Prices (CoinGecko) ───────────────────────────────────────────────────────
# Optional key. demo | pro
COINGECKO_API_KEY=
COINGECKO_API_TIER=demo
COINGECKO_BASE_URL=
COINGECKO_REQUESTS_PER_MINUTE=25
